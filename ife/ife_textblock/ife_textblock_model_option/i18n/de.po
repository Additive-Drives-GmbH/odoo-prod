#. module: ife_textblock_model_option
#: model:ir.model.fields,field_description:ife_textblock_model_option.field_text_block__direct_render
msgid "Direct Render"
msgstr "Direktes Rendern"

#. module: ife_textblock_model_option
#: model:ir.model.fields,help:ife_textblock_model_option.field_text_block__direct_render
msgid "If checked, the textblock will be rendered directly in the report."
msgstr "Wenn aktiviert, wird der Textblock direkt im Bericht gerendert."

#. module: ife_textblock_model_option
#: model:ir.model.fields.selection,name:ife_textblock_model_option.selection__text_block__textblock_position__post
msgid "Post Order Lines"
msgstr "Nach den Produktzeilen"

#. module: ife_textblock_model_option
#: model:ir.model.fields.selection,name:ife_textblock_model_option.selection__text_block__textblock_position__pre
msgid "Pre Order Lines"
msgstr "Vor den Produktzeilen"

#. module: ife_textblock_model_option
#: model:ir.model.fields,help:ife_textblock_model_option.field_text_block__textblock_position
msgid ""
"Specify whether to show the textblock before (Pre) or after (Post) the main "
"content."
msgstr ""
"Geben Sie an, ob der Textblock vor (Pre) oder nach (Post) dem Hauptinhalt angezeigt werden soll."

#. module: ife_textblock_model_option
#: model:ir.model,name:ife_textblock_model_option.model_text_block
msgid "Text block that can added to reports in related models"
msgstr "Textblock, der zu Berichten in verwandten Modellen hinzugefügt werden kann"

#. module: ife_textblock_model_option
#: model:ir.model.fields,field_description:ife_textblock_model_option.field_text_block__textblock_position
msgid "Textblock Position"
msgstr "Textblockposition"