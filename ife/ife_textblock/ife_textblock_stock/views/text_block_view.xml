<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="text_block_stock_action" model="ir.actions.act_window">
        <field name="name">Text Block Action</field>
        <field name="res_model">text.block</field>
        <field name="view_mode">list,form</field>
        <field
            name="domain"
        >[('model_ids.model','=','stock.picking'),('is_template','=',True)]</field>
        <field
            name="context"
        >{'default_res_model': 'stock.picking','default_is_template':True}</field>
    </record>

    <menuitem
        name="Text Blocks"
        action="text_block_stock_action"
        id="text_block_stock_menu"
        parent="stock.menu_stock_config_settings"
    />
</odoo>
