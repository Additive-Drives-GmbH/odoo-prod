<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_saleorder_document"
        inherit_id="sale.report_saleorder_document"
        priority="15"
    >
        <!-- Pre-Lines Text-blocks -->

        <xpath
            expr="//table[hasclass('o_has_total_table','table','o_main_table','table-borderless')]"
            position="before"
        >
            <t
                t-foreach="doc.above_text_block_ids.filtered(
    lambda p:
        not p.not_print
        and (
            doc.state in ('draft', 'sent')
            or p.show_in_order
        )
).sorted(lambda x: x.sequence)"
                t-as="t"
            >
                <t t-if="t.post_page_break and t.pre_page_break">
                    <p style="page-break-before: always;" />
                    <p>
                        <t t-out="t.text" />
                    </p>
                    <p style="page-break-after: always;" />
                </t>
                <!-- only pre-->
                <t t-if="t.pre_page_break and not t.post_page_break">
                    <p>
                        <t t-out="t.text" />
                    </p>
                    <p style="page-break-after: always;" />
                </t>
                <!-- only Post-->
                <t t-if="t.post_page_break and not t.pre_page_break">
                    <p style="page-break-before: always;" />
                    <p>
                        <t t-out="t.text" />
                    </p>
                </t>
                <!-- no Post no pre-->
                <t t-if="not t.post_page_break and not t.pre_page_break">
                    <p>
                        <t t-out="t.text" />
                    </p>
                </t>
            </t>
        </xpath>

        <!-- Post-Lines Text-blocks -->

        <xpath expr="//p[@id='fiscal_position_remark']" position="after">
            <t
                t-foreach="doc.bottom_text_block_ids.filtered(
    lambda p:
        not p.not_print
        and (
            doc.state in ('draft', 'sent')
            or p.show_in_order
        )
).sorted(lambda x: x.sequence)"
                t-as="t"
            >
                <t t-if="t.post_page_break and t.pre_page_break">
                    <p style="page-break-before: always;" />
                    <p>
                        <t t-out="t.text" />
                    </p>
                    <p style="page-break-after: always;" />
                </t>
                <!-- only pre-->
                <t t-if="t.pre_page_break and not t.post_page_break">
                    <p>
                        <t t-out="t.text" />
                    </p>
                    <p style="page-break-after: always;" />
                </t>
                <!-- only Post-->
                <t t-if="t.post_page_break and not t.pre_page_break">
                    <p style="page-break-before: always;" />
                    <p>
                        <t t-out="t.text" />
                    </p>
                </t>
                <!-- no Post no pre-->
                <t t-if="not t.post_page_break and not t.pre_page_break">
                    <p>
                        <t t-out="t.text" />
                    </p>
                </t>
            </t>
        </xpath>

        <!-- Lines Text-blocks-->

        <xpath expr="//t[@t-foreach='lines_to_report']/tr[1]/t[1]" position="inside">
            <tr t-if="not line.display_type">
                <td colspan="99">
                    <span style="" t-field="line.text_block_id.text" />
                </td>
            </tr>
        </xpath>
    </template>
</odoo>
