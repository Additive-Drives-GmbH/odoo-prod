<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_text_block_form_inherit" model="ir.ui.view">
        <field name="name">text.block.form.view</field>
        <field name="model">text.block</field>
        <field name="inherit_id" ref="ife_textblock.view_textblock_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='show_in_invoice']" position="after">
                <field name="proforma" groups="sale.group_proforma_sales" />
                <field
                    name="country_id"
                    options="{'no_create': True}"
                    groups="sale.group_proforma_sales"
                />
            </xpath>
        </field>
    </record>
</odoo>
