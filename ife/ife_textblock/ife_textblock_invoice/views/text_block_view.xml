<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="text_block_move_action" model="ir.actions.act_window">
        <field name="name">Text Block Action</field>
        <field name="res_model">text.block</field>
        <field name="view_mode">list,form</field>
        <field
            name="domain"
        >[('model_ids.model','in',('account.move','account.move.line')),('is_template','=',True)]</field>
        <field
            name="context"
        >{'default_res_model': 'account.move','default_is_template':True}</field>
    </record>
    <menuitem
        name="Text Blocks"
        action="text_block_move_action"
        id="text_block_move_menu"
        parent="account.menu_finance_configuration"
    />
</odoo>
