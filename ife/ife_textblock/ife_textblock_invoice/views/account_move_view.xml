<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_move_form_extended" model="ir.ui.view">
        <field name="name">Account Move</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- Pre-Lines Text-blocks -->

            <xpath expr="//field[@name='invoice_line_ids']" position="before">
                <separator string="Pre-Lines Textblocks" />
                <field
                    name="above_text_block_ids"
                    context="{'default_res_model': 'account.move'}"
                >
                    <list>
                        <field name="sequence" widget="handle" />
                        <field name="textblock" />
                        <field name="post_page_break" optional="hidden" />
                        <field name="pre_page_break" optional="hidden" />
                        <field name="not_print" optional="hidden" />
                    </list>
                </field>
            </xpath>

            <!--Post-Lines Text-blocks-->

            <xpath expr="//field[@name='invoice_line_ids']" position="after">
                <separator string="Post-Lines Textblocks" />

                <field
                    name="bottom_text_block_ids"
                    context="{'default_res_model': 'account.move'}"
                >
                    <list>
                        <field name="sequence" widget="handle" />
                        <field name="textblock" />
                        <field name="post_page_break" optional="hidden" />
                        <field name="pre_page_break" optional="hidden" />
                        <field name="not_print" optional="hidden" />
                    </list>
                </field>
            </xpath>

            <!--Lines Tex-blocks -->

            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='account_id']"
                position="before"
            >
                <field
                    name="text_block_id"
                    context="{'default_res_model': 'account.move.line','default_inline_check':True}"
                    optional="show"
                    domain="[('res_id', '=', id),('inline_check','=',True)]"
                />
            </xpath>
        </field>
    </record>
</odoo>
