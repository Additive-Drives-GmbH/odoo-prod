<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="text_block_purchase_action" model="ir.actions.act_window">
        <field name="name">Text Block Action</field>
        <field name="res_model">text.block</field>
        <field name="view_mode">list,form</field>
        <field
            name="domain"
        >[('model_ids.model','in',('purchase.order','purchase.order.line')),('is_template','=',True)]</field>
        <field
            name="context"
        >{'default_res_model': 'purchase.order','default_is_template':True}</field>
    </record>

    <menuitem
        name="Text Block"
        action="text_block_purchase_action"
        id="text_block_purchase_menu"
        parent="purchase.menu_purchase_config"
    />
</odoo>
