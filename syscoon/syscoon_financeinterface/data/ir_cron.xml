<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Scheduled Action for Batch Processing -->
    <record id="ir_cron_item_processor" model="ir.cron">
        <field name="name">Finance Interface Item Processor</field>
        <field name="model_id" ref="model_syscoon_financeinterface_item"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_items()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
