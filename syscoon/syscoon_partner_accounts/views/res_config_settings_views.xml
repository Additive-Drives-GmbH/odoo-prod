<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50"/>
        <field name="inherit_id" ref="syscoon_partner_customer_supplier_number.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Row 1: Add Auto Account Creation, Use Separate Accounts, and Sequences before customer_number_sequence -->
            <xpath expr="//setting[@id='customer_number_sequence_setting']" position="before">
                <setting id="auto_account_creation_setting" company_dependent="1" help="Activate the Account Generation for this company. If activated, all options including the menu entries will be visible.">
                    <field name="auto_account_creation" string="Activate Debit- and Credit Account Generation"/>
                </setting>
                <setting id="use_separate_accounts_setting" company_dependent="1" help="Use separate accounts in chart of accounts. Option is not preferred, as Odoo handles this differently." invisible="not auto_account_creation">
                    <field name="use_separate_accounts" string="Use separate debit and credit accounts"/>
                </setting>
                <setting id="receivable_sequence_setting" company_dependent="1" help="Receivable sequence for generating the debit account number." invisible="not auto_account_creation">
                    <label for="receivable_sequence_id"/>
                    <div class="o_row">
                        <field name="receivable_sequence_id" domain="[('company_id', '=', company_id), ('code', '=', 'partner.auto.receivable')]"/>
                        <button name="action_create_receivable_sequence" type="object"
                            string="Create Receivable Sequence"
                            help="Creates a new receivable sequence if it does not exist yet."
                            class="btn-link mb-1 px-0" icon="fa-refresh"
                            invisible="receivable_sequence_id"/>
                    </div>
                </setting>
                <setting id="payable_sequence_setting" company_dependent="1" help="Payable sequence for generating the credit account number." invisible="not auto_account_creation">
                    <label for="payable_sequence_id"/>
                    <div class="o_row">
                        <field name="payable_sequence_id" domain="[('company_id', '=', company_id), ('code', '=', 'partner.auto.payable')]"/>
                        <button name="action_create_payable_sequence" type="object"
                            string="Create Payable Sequence"
                            help="Creates a new payable sequence if it does not exist yet."
                            class="btn-link mb-1 px-0" icon="fa-refresh"
                            invisible="payable_sequence_id"/>
                    </div>
                </setting>
            </xpath>
            <!-- Row 2: Add Receivable/Payable Templates and Copy Numbers setting before add_number_to_partner_ref -->
            <xpath expr="//setting[@id='add_number_to_partner_ref_setting']" position="before">
                <setting id="receivable_template_setting" company_dependent="1" help="Receivable account template, only necessary if 'Use separate accounts' is set to true." invisible="not use_separate_accounts">
                    <field name="receivable_template_id" options="{'no_create': True}"/>
                </setting>
                <setting id="payable_template_setting" company_dependent="1" help="Payable account template, only necessary if 'Use separate accounts' is set to true." invisible="not use_separate_accounts">
                    <field name="payable_template_id" options="{'no_create': True}"/>
                </setting>
                <setting id="add_number_to_partner_number_setting" company_dependent="1" help="When enabled, creating a Debitor number automatically sets the Customer number to the same value. Same for Creditor and Supplier." invisible="not auto_account_creation">
                    <field name="add_number_to_partner_number" string="Copy Debitor/Creditor Numbers to Customer/Supplier"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
