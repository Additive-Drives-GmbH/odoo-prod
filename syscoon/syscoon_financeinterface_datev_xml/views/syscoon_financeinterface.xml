<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="syscoon_financeinterface_xml_form_view" model="ir.ui.view">
        <field name="name">syscoon.financeinterface.form.view</field>
        <field name="model">syscoon.financeinterface</field>
        <field name="inherit_id" ref="syscoon_financeinterface.syscoon_financeinterface_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" invisible="mode != 'datev_xml'" role="alert" colspan="2">
                    <strong>File Size Limit: </strong>
                    <span>The final export ZIP file must not exceed 476 MB (DATEV limitation). Adjust the Items Limit if needed.</span>
                </div>
                <div class="alert alert-warning" role="alert" invisible="failed_items == 0 or state != 'export'">
                    <strong>Partial Success: </strong>
                    <span>
                        <field name="failed_items" readonly="1" class="oe_inline"/>
                        item(s) failed to export. The export file contains only successful items. Check the Export Items tab for error details.</span>
                </div>
                <div class="alert alert-info" invisible="mode != 'datev_xml'" role="alert" colspan="2">
                    <strong>Note: </strong>
                    <span>Auto Process is enabled by default. If disabled, you must click 'Process Items' to start processing manually.</span>
                </div>
            </xpath>

            <!-- Add Process Items button to header -->
            <xpath expr="//button[@name='action_export']" position="after">
                <button string="Process Items" name="action_process_items" type="object" class="btn-primary" invisible="state != 'queued' or not is_batch_supported or auto_process"/>
                <button string="Retry Failed Items" name="action_retry_failed_items" type="object" class="btn-secondary" invisible="state != 'export' or mode != 'datev_xml' or failed_items == 0"/>
            </xpath>

            <!-- Hide Export button when there are pending items in datev_xml mode -->
            <xpath expr="//button[@name='action_export']" position="attributes">
                <attribute name="invisible">state == 'export' or (mode == 'datev_xml' and pending_items > 0)</attribute>
            </xpath>

            <!-- Override Reset button to also check bedi_move_count and working_zip_path -->
            <xpath expr="//button[@name='action_draft']" position="attributes">
                <attribute name="invisible">state == 'draft' and not account_moves_count and not total_items and not bedi_move_count and not working_zip_path</attribute>
            </xpath>

            <!-- Add XML mode fields after mode -->
            <xpath expr="//field[@name='mode']" position="after">
                <field name="is_batch_supported" invisible="1"/>
                <field name="bedi_move_count" invisible="1"/>
                <field name="working_zip_path" invisible="1"/>
                <field name="xml_mode" invisible="mode != 'datev_xml'" readonly="state != 'draft'"/>
                <field name="xml_invoices" invisible="mode != 'datev_xml'" readonly="state != 'draft' or xml_mode == 'x-rechnungen'" force_save="1"/>
                <field name="exclude_bedi_exported" invisible="mode != 'datev_xml'" readonly="state != 'draft'" widget="boolean_toggle"/>
            </xpath>

            <!-- Add batch settings -->
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="auto_process" invisible="not is_batch_supported" readonly="state not in ['draft', 'queued']" widget="boolean_toggle"/>
            </xpath>

            <!-- Add statistics group before notebook - always shown when batch is supported -->
            <xpath expr="//notebook" position="before">
                <group invisible="not is_batch_supported" string="Export Progress">
                    <group>
                        <field name="total_items" readonly="1"/>
                        <field name="completed_items" readonly="1"/>
                        <field name="failed_items" readonly="1"/>
                        <field name="pending_items" readonly="1"/>
                        <field name="progress" widget="progressbar" readonly="1"/>
                    </group>
                    <group>
                        <field name="batch_limit" invisible="not is_batch_supported" readonly="state not in ['draft', 'queued']"/>
                        <field name="items_limit" invisible="not is_batch_supported" readonly="state not in ['draft', 'queued']"/>
                        <field name="move_count" invisible="mode != 'datev_xml'" readonly="1"/>
                        <field name="working_zip_path" invisible="mode != 'datev_xml' or not working_zip_path" readonly="1"/>
                        <field name="working_zip_size" invisible="mode != 'datev_xml' or not working_zip_size" readonly="1"/>
                    </group>
                </group>
            </xpath>

            <!-- Add BEDI page -->
            <xpath expr="//page[@id='export_moves']" position="after">
                <page string="BEDI Invoices" invisible="not bedi_moves_ids">
                    <strong>
                        <label for="bedi_move_count" string="Number of Exported Records:"/>
                        <field name="bedi_move_count"/>
                    </strong>
                    <field colspan="2" nolabel="1" name="bedi_moves_ids"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="syscoon_financeinterface_tree_view" model="ir.ui.view">
        <field name="name">syscoon.financeinterface.tree.view</field>
        <field name="model">syscoon.financeinterface</field>
        <field name="inherit_id" ref="syscoon_financeinterface.syscoon_financeinterface_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_ids']" position="after">
                <field name="mode" column_invisible="1"/>
                <field name="xml_mode" invisible="mode != 'datev_xml'"/>
                <field name="xml_invoices" invisible="mode != 'datev_xml'"/>
            </xpath>
            <!-- Add failed items indicator before state -->
            <xpath expr="//field[@name='state']" position="before">
                <field name="is_batch_supported" column_invisible="1"/>
                <field name="failed_items" string="Errors" optional="show" decoration-danger="failed_items > 0" invisible="not is_batch_supported"/>
            </xpath>
        </field>
    </record>

</odoo>
