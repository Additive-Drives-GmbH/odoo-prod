<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.purchase.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']//form//field[@name='tax_calculation_rounding_method']"
                position="after"
            >
                <field name="position" force_save="1" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']//list//field[@name='sequence']"
                position="after"
            >
                <field name="position" string="Pos" force_save="1" optional="hide" />
            </xpath>
        </field>
    </record>

    <record model="ir.actions.server" id="action_compute_purchase_position">
        <field name="name">Recompute positions</field>
        <field name="model_id" ref="purchase.model_purchase_order" />
        <field name="binding_model_id" ref="purchase.model_purchase_order" />
        <field name="state">code</field>
        <field name="code">
        records.recompute_positions()
      </field>
    </record>
</odoo>
