<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">purchase.config.positioning.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='connectors_setting_container']" position="after">
                <block
                    title="Purchase Order Line Positions"
                    id="line_purchase_positioning_setting_container"
                >
                    <setting
                        id="line_purchase_positioning_options"
                        help="Do not recompute positions when line is removed"
                    >
                        <field name="disable_purchase_position_recompute" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
