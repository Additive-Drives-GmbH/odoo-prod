<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_purchaseorder_document_inherit"
        inherit_id="purchase.report_purchaseorder_document"
    >
        <!-- remove the table border from the product table -->
        <xpath expr="//table[hasclass('o_main_table')]" position="attributes">
            <attribute name="class" remove="table-borderless" separator=" " />
        </xpath>

        <!-- remove the table border from the totals table -->
        <xpath
            expr="//div[@id='total']//table[hasclass('o_total_table')]"
            position="attributes"
        >
            <attribute name="class" remove="table-borderless" separator=" " />
        </xpath>

        <!-- hide the whole discount column when no order line has a discount -->
        <xpath expr="//th[@name='th_discount']" position="attributes">
            <attribute name="t-if">any(l.discount for l in o.order_line)</attribute>
        </xpath>
        <xpath expr="//span[@t-field='line.discount']/../.." position="attributes">
            <attribute name="t-if">any(l.discount for l in o.order_line)</attribute>
        </xpath>

        <!-- within a visible discount column, hide the value on lines without a discount -->
        <xpath expr="//span[@t-field='line.discount']/.." position="attributes">
            <attribute name="t-if">line.discount</attribute>
        </xpath>
    </template>
</odoo>
