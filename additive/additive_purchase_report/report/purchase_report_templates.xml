<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_purchaseorder_document_inherit"
        inherit_id="purchase.report_purchaseorder_document"
    >
        <xpath expr="//table[hasclass('o_main_table')]" position="before">
            <table class="table table-borderless" style="border-collapse: collapse;">
                <tr>
                    <t t-if='o.dest_address_id'>
                        <td style="padding:0; margin:0;">
                            <span class="fw-bold">Shipping Address:</span>
                        </td>
                        <td style="padding:0; margin:0;">
                            <div>
                                <strong>
                                    <span t-field="o.dest_address_id.name" />,
                                    <span t-field="o.dest_address_id.street" />,
                                    <span t-field="o.dest_address_id.zip" /> <span
                                    t-field="o.dest_address_id.city"
                                />
                                </strong>
                            </div>
                        </td>
                    </t>
                    <t
                        t-elif="'picking_type_id' in o._fields and o.picking_type_id.warehouse_id"
                    >
                        <td style="padding:0; margin:0;">
                            <span class="fw-bold">Shipping Address:</span>
                        </td>
                        <td style="padding:0; margin:0;">
                            <div>
                                <strong>
                                    <span
                                    t-field="o.picking_type_id.warehouse_id.partner_id.name"
                                />,
                                    <span
                                    t-field="o.picking_type_id.warehouse_id.partner_id.street"
                                />,
                                    <span
                                    t-field="o.picking_type_id.warehouse_id.partner_id.zip"
                                /> <span
                                    t-field="o.picking_type_id.warehouse_id.partner_id.city"
                                />
                                </strong>
                            </div>
                        </td>
                    </t>
                </tr>
                <tr
                    t-if="o and o._name=='purchase.order' and o.date_order"
                    name="order_deadline_row"
                >
                    <td style="padding:0; margin:0;">
                        <span class="fw-bold">Order Deadline:</span>
                    </td>
                    <td style="padding:0; margin:0;">
                        <div>
                            <span>
                                <t
                                    t-out="o.date_planned"
                                    t-options="{'widget': 'date'}"
                                />
                            </span>
                        </div>
                    </td>
                </tr>
                <tr
                    t-if="o and o._name=='purchase.order'"
                    name="invoice_address_row"
                    style="padding-top:0mm"
                >
                    <td style="padding:0; margin:0;">
                        <span class="fw-bold">Invoice Addresse:</span>
                    </td>
                    <td style="padding:0; margin:0;">
                        <div>
                            <span>invoice@additive-drives.de</span>
                        </div>
                    </td>
                </tr>
                <tr
                    t-if="o and o._name=='purchase.order'"
                    name="payment_terms_row"
                    style="padding-top:0mm"
                >
                    <td t-if="o.payment_term_id" style="padding:0; margin:0;">
                        <span class="fw-bold">Payment Terms:</span>
                    </td>
                    <td t-if="o.payment_term_id" style="padding:0; margin:0;">
                        <div>
                            <span>
                                <t t-out="o.payment_term_id.name" />
                            </span>
                        </div>
                    </td>
                </tr>
            </table>
        </xpath>

        <xpath expr="//div[@t-field='o.partner_id']" position="attributes">
            <attribute
                name="t-options"
            >{"widget": "contact", "fields": ["address", "name"], "no_marker": True}</attribute>
        </xpath>
        <!--Add Border-->
        <xpath expr="//table[hasclass('o_main_table')]" position="attributes">
            <attribute name="class">table o_main_table o_has_total_table</attribute>
        </xpath>
        <!--Add pos column-->
        <xpath expr="//th[@name='th_description']" position="before">
            <th class="text-start">Pos</th>
        </xpath>
        <xpath expr="//td[@id='product']" position="before">
            <td>
                <span t-field="line.position_formatted" />
            </td>
        </xpath>
        <!--Remove tax column-->
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath
            expr="//span[contains(@t-out, 'taxes_id')]/parent::td"
            position="attributes"
        >
            <attribute name="class">text-end d-none</attribute>
        </xpath>
        <!--Hide Total-->
        <xpath expr="//div[@id='total']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
        <!--Add new Total-->
        <xpath expr="//tbody" position="inside">
            <t t-set="tax_totals" t-value="o.tax_totals" />
            <t t-set="currency" t-value="o.currency_id" />
            <tr class="is-subtotal text-end">
                <td name="td_total" colspan="99">
                    <strong class="mr16">Total</strong>
                    <strong
                        t-out="tax_totals['total_amount_currency']"
                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}"
                    >31.05</strong>
                </td>
            </tr>
        </xpath>
        <!--Add Payment terms-->
        <xpath expr="//span[@t-field='o.payment_term_id']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath
            expr="//span[@t-field='o.payment_term_id']/preceding-sibling::strong[1]"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath expr="//div[@id='total']" position="after">
            <t t-if="o.partner_id.lang and o.partner_id.lang == 'de_DE'">
                <p>Mit freundlichen Grüßen<br /><br />
                <strong>
                    <span t-field="o.user_id.name" />
                </strong><br />
                <strong>
                    <span
                        t-if="o.user_id and o.user_id.employee_id and o.user_id.employee_id.job_id"
                        t-field="o.user_id.employee_id.job_id.name"
                    />
                </strong></p>
            </t>
        </xpath>
        <xpath expr="//span[@t-field='line.price_unit']" position="attributes">
            <attribute
                name="t-options"
            >{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}</attribute>
        </xpath>
        <xpath expr="//span[@t-field='line.discount']" position="attributes">
            <attribute name="style">padding-right: 2px;</attribute>
        </xpath>
        <!-- hide discount -->
        <xpath
            expr="//td[hasclass('text-end')]/span/span[@t-field='line.discount']/../.."
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath expr="//th[@name='th_discount']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
    </template>
</odoo>
