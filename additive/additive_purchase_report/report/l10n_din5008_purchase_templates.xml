<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_common_purchase_din5008_template_document_information_inherit"
        inherit_id="l10n_din5008_purchase.report_common_purchase_din5008_template_document_information"
    >
        <xpath
            expr="//div[hasclass('information_block')]/table/tr[@t-if='o.name']"
            position="after"
        >
            <tr t-if="o.partner_id.commercial_partner_id and o.partner_id.commercial_partner_id.our_nr_by_vendor">
                <td>Customer Nr.:</td>
                <td>
                    <t t-out="o.partner_id.commercial_partner_id.our_nr_by_vendor" />
                </td>
            </tr>
            <tr t-if="o.project_id">
                <td>Project:</td>
                <td>
                    <t t-out="o.project_id.name" />
                </td>
            </tr>
        </xpath>
        <xpath
            expr="//div[hasclass('information_block')]/table/tr[@t-if='o.user_id']"
            position="after"
        >
            <tr t-if="o.user_id and o.user_id.email">
                <td>Email:</td>
                <td class="text-nowrap">
                    <t t-out="o.user_id.email" />
                </td>
            </tr>
        </xpath>
    </template>

    <template
        id="external_layout_din5008_purchase_sender_vat"
        inherit_id="l10n_din5008.external_layout_din5008"
    >
        <xpath
            expr="//div[@id='din5008_report_main_address']/div[hasclass('colored_address')]"
            position="inside"
        >
            <t t-if="o and o._name == 'purchase.order' and company.vat">
                <span>|</span>
                <span t-out="company.account_fiscal_country_id.vat_label or 'Tax ID'" />: <span
                    t-field="company.vat"
                />
            </t>
        </xpath>
    </template>
</odoo>
