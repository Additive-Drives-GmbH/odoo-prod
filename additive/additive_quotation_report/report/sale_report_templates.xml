<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_saleorder_document_inherit"
        inherit_id="sale.report_saleorder_document"
        priority="100"
    >
        <xpath expr="//t[@t-set='forced_vat']" position="after">
            <t t-set="euro_currency" t-value="env.ref('base.EUR')" />
            <t
                t-if="doc.partner_id.lang == 'en_US' and doc.currency_id.id != euro_currency.id"
            >
                <t t-set="foreign_partner" t-value="True" />
            </t>
            <t
                t-if="(doc.partner_id.lang == 'en_US' and doc.currency_id.id != euro_currency.id) or doc.partner_id.lang == 'de_DE'"
            >
                <t t-set="vat_label" t-value="'UST-ID'" />
            </t>
            <t t-else="">
                <t t-set="vat_label" t-value="'VAT-ID'" />
            </t>
        </xpath>
        <!-- Show Text before table -->
        <xpath expr="//table[hasclass('o_main_table')]" position="before">
            <t t-if="doc.state in ('draft','sent')">
                <p style="margin-bottom: -5mm;">
                    <strong>Subject To Change we offer:</strong>
                </p>
            </t>
            <t t-else="">
                <p style="margin-bottom: -5mm;">
                    <strong>The order includes the following work packages:</strong>
                </p>
            </t>
        </xpath>
        <!-- Remove table-borderless -->
        <xpath expr="//table[hasclass('o_main_table')]" position="attributes">
            <attribute name="class" remove="table-borderless" separator=" "></attribute>
        </xpath>
        <!-- hide tax column -->
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath expr="//td[@name='td_product_taxes']" position="attributes">
            <attribute name="t-attf-class">{{'d-none'}}</attribute>
        </xpath>
        <!-- rename quantity -->
        <xpath expr="//th[@name='th_quantity']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath expr="//th[@name='th_quantity']" position="after">
            <th name="th_quantity" class="text-end text-nowrap" width="10%">Qnt.</th>
        </xpath>
        <!-- rename amount -->
        <xpath expr="//th[@name='th_subtotal']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath expr="//th[@name='th_subtotal']" position="after">
            <th name="th_subtotal" class="text-end">Line Price</th>
        </xpath>
        <!-- center section line -->
        <xpath expr="//td[@name='td_section_group_name']" position="attributes">
            <attribute name="class">text-center</attribute>
        </xpath>
        <!-- hide total table -->
        <xpath expr="//div[@id='total']//table" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
        <!--add new total row-->
        <xpath expr="//tbody" position="inside">
            <t t-set="tax_totals" t-value="doc.tax_totals" />
            <t t-set="currency" t-value="doc.currency_id" />
            <tr
                class="is-subtotal text-end"
                style="background-color: #a0a0a0 !important;"
            >
                <td name="td_total" colspan="99">
                    <strong class="mr16">Total</strong>
                    <strong
                        t-out="tax_totals['base_amount_currency']"
                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}"
                    >31.05</strong>
                </td>
            </tr>
        </xpath>

        <!-- Move Totals table -->
        <xpath expr="//table[hasclass('o_main_table')][1]" position="after">
            <p style="margin-top: -5mm;">
                All prices are net prices
            </p>
        </xpath>
        <xpath expr="//span[@t-field='line.price_unit']" position="attributes">
            <attribute
                name="t-options"
            >{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: currency}</attribute>
        </xpath>
        <!-- hier wurde die ursprüngliche POs spalte ausgeblendet und wieder eingeblendet... why??? -->
<!--        <xpath-->
<!--            expr="//table/thead/tr/th[hasclass('text-start')][1]"-->
<!--            position="attributes"-->
<!--        >-->
<!--            <attribute name="class">text-start d-none</attribute>-->
<!--        </xpath>-->
<!--        <xpath expr="//table/thead/tr/th[hasclass('text-start')][1]" position="after">-->
<!--            <th class="text-start">Pos.</th>-->
<!--        </xpath>-->

        <xpath expr="//span[@t-field='line.product_uom_id']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
        <!-- add new column item-->
        <xpath expr="//th[@name='th_description']" position="attributes">
            <attribute name="class">text-start d-none</attribute>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_description" class="text-start">Item</th>
        </xpath>
    </template>

    <template
        id="report_saleorder_document_l10n_din5008_inherit"
        inherit_id="l10n_din5008_sale.report_saleorder_document"
    >
        <!-- hide part with validity_date -->
        <xpath expr="//tr[@t-if='doc.validity_date']/.." position="replace" />
        <!-- and hide the part with the commitment date as well -->
        <xpath expr="//tr[@t-if='doc.commitment_date']/.." position="replace" />

        <!-- show the payment term name as well as the custom field country_of_origin_id in the info block -->
        <xpath expr="//div[hasclass('information_block')]/table" position="inside">
            <tr t-if="doc.payment_term_id">
                <td>Payment Terms:</td>
                <td>
                    <div t-field="doc.payment_term_id.name"/>
                </td>
            </tr>
        </xpath>

        <!-- rename 'Incoterms' to 'Incoterms (ICC)' -->
        <xpath expr="//tr[@t-if=&quot;'incoterm' in doc._fields and doc.incoterm&quot;]/td[1]" position="replace">
            <td>Incoterm (ICC):</td>
        </xpath>

        <xpath expr="//t[@t-set='din5008_address_block']/tr" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath expr="//t[@t-set='din5008_document_title']/span" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath expr="//t[@t-set='din5008_document_title']/span" position="after">
            <strong>
                <t t-if="doc.state in ('draft','sent')">
                    Offer No. <t t-out="doc.name" />
                </t>
                <t t-else="">
                    Order Confirmation <t t-out="doc.name" />
                </t>
            </strong>
        </xpath>

        <!-- show the location and Date-->
        <xpath expr="//div[hasclass('information_block')]/table" position="after">
            <div style="position: absolute; top: 45mm; right: 10mm;">
                <t t-out="doc.company_id.city"/>,
                <t t-out="datetime.datetime.now().strftime('%d.%m.%Y')"/>
            </div>
        </xpath>
    </template>
    <template
        id="external_layout_din5008_saleorder_inherit"
        inherit_id="l10n_din5008_sale.external_layout_din5008_saleorder"
    >
        <xpath
            expr="//div[@id='partner_vat_address_same_as_shipping'][1]"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath expr="//div[@t-if='main_addr_id.vat']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
    </template>
</odoo>
