<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_delivery_document_additive"
        inherit_id="stock.report_delivery_document"
    >
        <xpath expr="//t[@t-set='address']" position="after">
            <t t-set="is_delivery_report" t-value="True" />
        </xpath>

        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="class">d-none</attribute>
            <attribute name="style">display: none !important;</attribute>
        </xpath>

        <xpath expr="//table[@name='stock_move_table']" position="before">
            <div class="mb-3">
                <p>Dear Sir or Madam,</p>
                <p
                >we thank you for the good cooperation and deliver the following goods:</p>
            </div>
        </xpath>

        <xpath expr="//table[@name='stock_move_table']" position="attributes">
            <attribute name="class">table table-bordered</attribute>
            <attribute name="style">border: 2px solid #000;</attribute>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_product']"
            position="before"
        >
            <th
                name="th_sm_position"
                class="text-center"
                style="width: 10%; border: 1px solid #000; vertical-align: top;"
            >
                <strong>Pos.</strong>
            </th>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_product']"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
            <attribute name="style">display: none !important;</attribute>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_product']"
            position="before"
        >
            <th class="text-start" style="border: 1px solid #000; vertical-align: top;">
                <strong>Item</strong>
            </th>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_ordered']"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
            <attribute name="style">display: none !important;</attribute>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_quantity']"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
            <attribute name="style">display: none !important;</attribute>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_quantity']"
            position="before"
        >
            <th class="text-start" style="border: 1px solid #000; vertical-align: top;">
                <strong>Quantity</strong>
            </th>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_table']/tbody/tr[@t-foreach='lines']/td[1]"
            position="before"
        >
            <td
                class="text-center"
                style="border: 1px solid #000; white-space: nowrap; vertical-align: top;"
            >
                <span t-esc="'{:03d}'.format((move_index + 1) * 10)" />
            </td>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_table']/tbody/tr[@t-foreach='lines']/td[2]"
            position="attributes"
        >
            <attribute
                name="style"
            >border: 1px solid #000; vertical-align: top;</attribute>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_table']/tbody/tr[@t-foreach='lines']/td[.//span[@t-field='move.product_uom_qty']]"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
            <attribute name="style">display: none !important;</attribute>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_table']/tbody/tr[@t-foreach='lines']/td[.//span[@t-field='move.quantity']]"
            position="attributes"
        >
            <attribute name="class">o_td_quantity text-start</attribute>
            <attribute
                name="style"
            >border: 1px solid #000; vertical-align: top;</attribute>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_table']/tbody/tr[@t-foreach='lines']/td[.//span[@t-field='move.quantity']]/span[@t-field='move.product_uom']"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
            <attribute name="style">display: none !important;</attribute>
        </xpath>

        <xpath expr="//table[@name='stock_move_line_table']" position="attributes">
            <attribute name="class">table table-bordered mt48</attribute>
            <attribute name="style">border: 2px solid #000;</attribute>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_product']"
            position="before"
        >
            <th
                name="th_sml_position"
                class="text-center"
                style="width: 10%; border: 1px solid #000; vertical-align: top;"
            >
                <strong>Pos.</strong>
            </th>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_product']"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
            <attribute name="style">display: none !important;</attribute>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_product']"
            position="before"
        >
            <th class="text-start" style="border: 1px solid #000; vertical-align: top;">
                <strong>Item</strong>
            </th>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_qty_ordered']"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
            <attribute name="style">display: none !important;</attribute>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_quantity']"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
            <attribute name="style">display: none !important;</attribute>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_quantity']"
            position="before"
        >
            <th class="text-start" style="border: 1px solid #000; vertical-align: top;">
                <strong>Quantity</strong>
            </th>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='lot_serial']"
            position="attributes"
        >
            <attribute
                name="style"
            >border: 1px solid #000; vertical-align: top;</attribute>
        </xpath>

        <xpath
            expr="//div[@class='page']/div[@class='oe_structure'][last()]"
            position="before"
        >
            <div class="mt-5">
                <p style="margin-bottom: 30px;">Best regards</p>
                <p t-if="o.sale_id.user_id" style="margin-bottom: 60px;">
                    <span t-esc="o.sale_id.user_id.name" />
                </p>

                <div
                    style="border-top: 1px solid #000; width: 200px; padding-top: 2px;"
                >
                    <p class="mb-0">Delivery received</p>
                    <p>(Date, Signature)</p>
                </div>
            </div>
        </xpath>
    </template>

    <template
        id="stock_report_delivery_aggregated_move_lines_position"
        inherit_id="stock.stock_report_delivery_aggregated_move_lines"
    >
        <xpath expr="//tr[@t-foreach='aggregated_lines']/td[1]" position="before">
            <td
                class="text-center"
                style="border: 1px solid #000; white-space: nowrap; vertical-align: top;"
            >
                <span t-esc="'{:03d}'.format((line_index + 1) * 10)" />
            </td>
        </xpath>

        <xpath expr="//tr[@t-foreach='aggregated_lines']/td[2]" position="attributes">
            <attribute
                name="style"
            >border: 1px solid #000; vertical-align: top;</attribute>
        </xpath>

        <xpath
            expr="//tr[@t-foreach='aggregated_lines']/td[@name='move_line_aggregated_qty_ordered']"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
            <attribute name="style">display: none !important;</attribute>
        </xpath>

        <xpath
            expr="//tr[@t-foreach='aggregated_lines']/td[@name='move_line_aggregated_quantity']"
            position="attributes"
        >
            <attribute name="class">text-start</attribute>
            <attribute
                name="style"
            >border: 1px solid #000; vertical-align: top;</attribute>
        </xpath>

        <xpath
            expr="//tr[@t-foreach='aggregated_lines']/td[@name='move_line_aggregated_quantity']/t/span[2]"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
            <attribute name="style">display: none !important;</attribute>
        </xpath>
    </template>

    <template
        id="stock_report_delivery_has_serial_move_line_position"
        inherit_id="stock.stock_report_delivery_has_serial_move_line"
    >
        <xpath expr="//td[1]" position="before">
            <td
                class="text-center"
                style="border: 1px solid #000; white-space: nowrap; vertical-align: top;"
            >
                <span t-esc="'{:03d}'.format((move_line_index + 1) * 10)" />
            </td>
        </xpath>

        <xpath expr="//td[2]" position="attributes">
            <attribute
                name="style"
            >border: 1px solid #000; vertical-align: top;</attribute>
        </xpath>

        <xpath expr="//t[@name='move_line_lot']/td" position="attributes">
            <attribute
                name="style"
            >border: 1px solid #000; vertical-align: top;</attribute>
        </xpath>

        <xpath expr="//td[@name='move_line_lot_quantity']" position="attributes">
            <attribute name="class">text-start</attribute>
            <attribute
                name="style"
            >border: 1px solid #000; vertical-align: top;</attribute>
        </xpath>

        <xpath
            expr="//td[@name='move_line_lot_quantity']/span[@t-field='move_line.product_uom_id']"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
            <attribute name="style">display: none !important;</attribute>
        </xpath>
    </template>

    <template
        id="report_delivery_document_hide_hs_code"
        inherit_id="stock_delivery.report_delivery_document2"
        priority="100"
    >
        <xpath
            expr="//table[@name='stock_move_line_table']/thead/tr/th[@t-if='has_hs_code']"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
            <attribute name="style">display: none !important;</attribute>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_table']/thead/tr/th[@t-if='has_hs_code']"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
            <attribute name="style">display: none !important;</attribute>
        </xpath>

        <xpath
            expr="//table[@name='stock_move_table']/tbody/tr/td[@t-if='has_hs_code']"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
            <attribute name="style">display: none !important;</attribute>
        </xpath>
    </template>

    <template
        id="hide_hs_code_serial_move_line"
        inherit_id="stock_delivery.stock_report_delivery_has_serial_move_line_inherit_delivery"
        priority="100"
    >
        <xpath expr="//td[@t-if='has_hs_code']" position="attributes">
            <attribute name="class">d-none</attribute>
            <attribute name="style">display: none !important;</attribute>
        </xpath>
    </template>

    <template
        id="hide_hs_code_aggregated_move_lines"
        inherit_id="stock_delivery.stock_report_delivery_aggregated_move_lines_inherit_delivery"
        priority="100"
    >
        <xpath expr="//td[@t-if='has_hs_code']" position="attributes">
            <attribute name="class">d-none</attribute>
            <attribute name="style">display: none !important;</attribute>
        </xpath>
    </template>
</odoo>
