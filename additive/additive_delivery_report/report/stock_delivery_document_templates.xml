<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_delivery_document_additive"
        inherit_id="stock.report_delivery_document"
    >
        <!-- remove the table border from the product tables -->
        <xpath expr="//table[@name='stock_move_table']" position="attributes">
            <attribute name="class" remove="table-borderless" separator=" " />
        </xpath>
        <xpath expr="//table[@name='stock_move_line_table']" position="attributes">
            <attribute name="class" remove="table-borderless" separator=" " />
        </xpath>

        <!-- hide the product name and show only the description -->
        <xpath
            expr="//table[@name='stock_move_table']/tbody/tr[@t-foreach='lines']/td[1]/span[@t-field='move.product_id']"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath
            expr="//table[@name='stock_move_table']/tbody/tr[@t-foreach='lines']/td[1]/p"
            position="attributes"
        >
            <attribute name="t-if">move._get_report_description_picking()</attribute>
        </xpath>
    </template>

    <template
        id="stock_report_delivery_aggregated_move_lines_additive"
        inherit_id="stock.stock_report_delivery_aggregated_move_lines"
    >
        <!-- hide the product name and show only the description -->
        <xpath
            expr="//tr[@t-foreach='aggregated_lines']/td[1]/span"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
        </xpath>
    </template>

    <template
        id="stock_report_delivery_has_serial_move_line_additive"
        inherit_id="stock.stock_report_delivery_has_serial_move_line"
    >
        <!-- hide the product name and show only the description -->
        <xpath
            expr="//td[1]/span[@t-field='move_line.product_id']"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath expr="//td[1]/p" position="attributes">
            <attribute name="t-if">description != ''</attribute>
        </xpath>
    </template>
</odoo>
