<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="additive_invoice_tax_totals_template">
        <t t-set="tax_totals" t-value="o.tax_totals" />
        <t t-set="currency" t-value="o.currency_id" />
        <t t-set="same_tax_base" t-value="tax_totals['same_tax_base']" />
        <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
            <tr class="o_subtotal text-end">
                <td colspan="99">
                    <span class="mr16">Total Net</span>
                    <span
                        t-att-class="oe_subtotal_footer_separator"
                        t-out="subtotal['base_amount_currency']"
                        t-options='{"widget": "monetary", "display_currency": currency}'
                    >27.00</span>
                </td>
            </tr>
            <t t-foreach="subtotal['tax_groups']" t-as="tax_group">
                <tr class="o_taxes text-end">
                    <t
                        t-if="same_tax_base or tax_group['display_base_amount_currency'] is False"
                    >
                        <td colspan="99">
                            <span
                                t-out="tax_group['group_name']"
                                class="mr16"
                            >Tax 15%</span>
                            <span
                                class="text-nowrap"
                                t-out="tax_group['tax_amount_currency']"
                                t-options='{"widget": "monetary", "display_currency": currency}'
                            >1.05</span>
                        </td>
                    </t>
                    <t t-else="">
                        <td colspan="99">
                            <span t-out="tax_group['group_name']">Tax 15%</span>
                            <span> on </span>
                            <span
                                class="text-nowrap mr16"
                                t-out="tax_group['display_base_amount_currency']"
                                t-options='{"widget": "monetary", "display_currency": currency}'
                            >27.00</span>
                            <span
                                class="text-nowrap"
                                t-out="tax_group['tax_amount_currency']"
                                t-options='{"widget": "monetary", "display_currency": currency}'
                            >4.05</span>
                        </td>
                    </t>
                </tr>
            </t>
        </t>
        <tr t-if="'cash_rounding_base_amount_currency' in tax_totals" class="text-end">
            <td colspan="99">
                <span class="mr16">Rounding</span>
                <span
                    t-out="tax_totals['cash_rounding_base_amount_currency']"
                    t-options='{"widget": "monetary", "display_currency": currency}'
                >0</span>
            </td>
        </tr>
        <tr class="is-subtotal text-end" style="background-color: #a0a0a0 !important;">
            <td name="td_total" colspan="99">
                <strong class="mr16">Total</strong>
                <strong
                    t-out="tax_totals['total_amount_currency']"
                    t-options='{"widget": "monetary", "display_currency": currency}'
                >31.05</strong>
            </td>
        </tr>
    </template>
</odoo>
