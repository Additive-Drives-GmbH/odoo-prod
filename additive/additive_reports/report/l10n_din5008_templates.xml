<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="external_layout_din5008_inherit"
        inherit_id="l10n_din5008.external_layout_din5008"
    >
        <xpath expr="//table[hasclass('company_header')]//tr/td[1]" position="inside">
            <img
                t-if="company.logo"
                t-att-src="image_data_uri(company.logo)"
                t-att-style="'max-height: %dmm;' % (din_header_spacing or 27)"
                class="logo_left"
            />
        </xpath>

        <xpath
            expr="//table[hasclass('company_header')]//tr/td[2]/img"
            position="attributes"
        >
            <attribute name="class">logo_right</attribute>
        </xpath>

        <xpath expr="//table[hasclass('company_header')]" position="after">
            <script>
                var match = window.location.search.match(/page=(\d+)/);
                var page = match ? parseInt(match[1]) : 0;
                if (page === 1) {
                    var r = document.querySelector('.logo_right');
                    if (r) { r.style.display = 'none'; }
                } else {
                    var l = document.querySelector('.logo_left');
                    if (l) { l.style.display = 'none'; }
                }
            </script>
        </xpath>

        <!-- manaTec 70747: remove company.report_header from header -->
        <xpath expr="//table[hasclass('company_header')]//div[@t-field='company.report_header']/.." position="replace"/>

        <!-- Adjust Footer -->
        <!-- manaTec 70747: replace the entire footer and rebuild it -->
        <xpath expr="//div[hasclass('company_details')]//tr" position="replace">
            <tr>
                <td>
                    <ul class="list-inline">
                        <li t-if="company.name">
                            <strong>
                                <span t-field="company.name"/>
                            </strong>
                        </li>
                    </ul>
                </td>
                <td>
                    <ul class="list-inline">
                        <li t-if="company.company_details"><span t-field="company.company_details"/></li>
                    </ul>
                </td>
                <td>
                    <ul class="list-inline">
                        <li t-if="company.general_manager_ids"><strong>General Manager</strong></li>
                        <t t-foreach="company.general_manager_ids.sorted(key=lambda r: r.name, reverse=True)" t-as="manager">
                            <li><span t-field="manager.name"/></li>
                        </t>
                    </ul>
                </td>
                <td>
                    <ul class="list-inline">
                        <li t-if="company.report_footer"><span t-field="company.report_footer"/></li>
                    </ul>
                </td>
                <td>
                    <ul class="list-inline">
                        <li t-if="company.report_header"><span t-field="company.report_header"/></li>
                    </ul>
                </td>
            </tr>
        </xpath>

        <!-- hide Country-->
        <xpath
            expr="//div[hasclass('colored_address')]/t[@t-if='company.country_id']/span[1]"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
        </xpath>
        <xpath
            expr="//div[hasclass('colored_address')]/t[@t-if='company.country_id']/span[2]"
            position="attributes"
        >
            <attribute name="class">d-none</attribute>
        </xpath>
    </template>

    <!-- invoice layout -->
    <template
        id="external_layout_din5008_account_move_inherit"
        inherit_id="l10n_din5008.external_layout_din5008_account_move"
    >
        <!-- hide phone -->
        <xpath expr="//address" position="attributes">
            <attribute
                name="t-options"
            >{"widget": "contact", "fields": ["address", "name"], "no_marker": True}</attribute>
        </xpath>
    </template>
</odoo>
