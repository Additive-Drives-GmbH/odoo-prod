<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="manatec_report_invoice_document_inherit" inherit_id="l10n_din5008.report_invoice_document">
        <!-- Add the users name and mail address here -->
        <xpath expr="//tr[@t-if='o.delivery_date']">
            <t t-if="o.user_id">
                <tr>
                    <td>Contact</td>
                    <td><t t-out="o.user_id.name"/></td>
                </tr>
                <tr t-if="o.user_id.email">
                    <td>E-Mail</td>
                    <td><t t-out="o.user_id.email"/></td>
                </tr>
            </t>

        </xpath>

        <!-- print the origin countries within the info block -->
        <xpath expr="//tr[@t-if='o.invoice_incoterm_id']" position="after">
            <t t-set="origin_countries" t-value="o._get_origin_countries()"/>
            <tr t-if="origin_countries">
                <td>Country of Origin</td>
                <td><t t-out="origin_countries"/></td>
            </tr>
        </xpath>

        <!-- remove the table border from the product table -->
        <xpath expr="//table[@name='invoice_line_table']" position="attributes">
            <attribute name="class" remove="table-borderless" separator=" "/>
        </xpath>

        <!-- remove the table border from the total table -->
        <xpath expr="//div[@id='total']//table[hasclass('o_total_table')]" position="attributes">
            <attribute name="class" remove="table-borderless" separator=" "/>
        </xpath>
    </template>

</odoo>
