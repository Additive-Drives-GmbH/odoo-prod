<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info_group']" position="inside">
                <field name="country_of_origin_id" options="{'no_create': True}" />
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='name']"
                position="after"
            >
                <field
                    name="report_description"
                    column_invisible="parent.move_type not in ['out_invoice', 'out_refund']"
                />
            </xpath>
        </field>
    </record>
</odoo>
