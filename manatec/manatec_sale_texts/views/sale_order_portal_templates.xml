<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sale_order_portal_content_inherit_manatec_pre_text" inherit_id="sale.sale_order_portal_content">
        <xpath expr="//div[@class='table-responsive']" position="before">
            <section t-if="not is_html_empty(sale_order.pre_text)" id="pre_text" class="mt-4 mb-4">
                <h4>Pre-Text</h4>
                <hr class="mt-0 mb-1"/>
                <em t-field="sale_order.pre_text"/>
            </section>
        </xpath>
    </template>
</odoo>
