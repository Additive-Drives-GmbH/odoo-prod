<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_inherit_manatec_texts" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.manatec.texts</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']//field[@name='note']" position="replace"/>
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Pre-Text" name="pre_text">
                    <field name="pre_text" nolabel="1" placeholder="Pre-Text..."/>
                </page>
                <page string="Post-Text" name="post_text">
                    <field name="note" nolabel="1" placeholder="Terms and conditions..."/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
