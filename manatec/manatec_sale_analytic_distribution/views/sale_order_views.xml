<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_line_view_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.line.view.form.inherit.analytic.display</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='price_subtotal']" position="before">
                <field name="analytic_account_display" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
