<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="sh_action_sale_order_quotation_revision" model="ir.actions.act_window">
        <field name="name">Sale Revisions</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="sale.view_quotation_tree" />
        <field name="domain">[('sh_sale_order_id', '=', active_id)]</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Revised Sale Order.
            </p>
        </field>
    </record>

    <record id="sale_order_inherited_view_sh_sale_revisions" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button name="sh_quotation_revision" string="Sale Order Revisions" class="oe_highlight" type="object" invisible="sh_sale_revision_config == False or state not in ['draft', 'sent', 'cancel']" />
            </xpath>

            <field name="name" position="after">
                <field name="sh_sale_order_id" invisible="1" />
                <field name="sh_sale_revision_config" invisible="1" />
            </field>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_inline oe_stat_button" type="object" name="open_quality_check" icon="fa-clipboard" invisible="so_count == 0 or sh_sale_revision_config == False">
                    <field string="Sale Revisions" name="so_count" widget="statinfo" />
                </button>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_inline oe_stat_button" string="Sale Order" type="object" name="for_normal_purchase" icon="fa-clipboard" invisible="parent_view_btn == True or sh_sale_revision_config == False">
                    <field name="parent_view_btn" invisible="1" />
                </button>
            </xpath>

            <xpath expr="//page[@name='customer_signature']" position="after">
                <page string="Sale Revisions" name="quotation_revision" invisible="so_count == 0 or sh_sale_revision_config == False">
                    <!-- <group> -->
                    <field name="sh_revision_so_id" widget="many2many_list" nolabel="1" readonly="1" />
                    <!-- </group> -->
                </page>
            </xpath>
        </field>
    </record>
</odoo>
