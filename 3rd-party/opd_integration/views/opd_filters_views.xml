<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_opd_filter_tree" model="ir.ui.view">
        <field name="name">opd.filter.tree</field>
        <field name="model">opd.filter</field>
        <field name="arch" type="xml">
            <list>
                <field name="filter_id"/>
            </list>
        </field>
    </record>

    <record id="view_opd_filter_form" model="ir.ui.view">
        <field name="name">opd.filter.form</field>
        <field name="model">opd.filter</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="filter_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_opd_integration_pipedrivefilter" model="ir.actions.act_window">
        <field name="name">Pipedrive Logger</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">opd.filter</field>
        <field name="view_mode">list,form</field>
        <field name="context"></field>
    </record>

    <menuitem id="menu_pipedrivefilter"
              name="Pipedrive Filter"
              action="action_opd_integration_pipedrivefilter"
              parent="menu_pipedrivelogger"
              sequence="2"/>

</odoo>
