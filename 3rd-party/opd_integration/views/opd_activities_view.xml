<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_mail_activities_form_inherit" model="ir.ui.view">
            <field name="name">mail.activity.form</field>
            <field name="model">mail.activity</field>
            <field name="inherit_id" ref="mail.mail_activity_view_form_popup"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date_deadline']" position="after">
                    <field name="pipedrive_activity_id"/>
                </xpath>
            </field>
        </record>

        <record id="view_mail_message_form_inherit" model="ir.ui.view">
            <field name="name">mail.message.form</field>
            <field name="model">mail.message</field>
            <field name="inherit_id" ref="mail.mail_message_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="pipedrive_notes_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>