<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_users_form_inherit" model="ir.ui.view">
            <field name="name">res.users.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                     <page string="Pipedrive Integration" name="Pipedrive Integration">
                         <group>
                             <field name="pipedrive_id"/>
                             <field name="odoo_hash"/>
                         </group>
                     </page>
                </xpath>
                 <xpath expr="//div[@name='button_box']" position="inside">
                     <button name="user_send_to_pipedrive" class="oe_stat_button oe_highlight" icon="fa-refresh" string='SYNC TO PIPEDRIVE' type="object"/>
                </xpath>
            </field>
        </record>

        <record id="view_users_tree_inherit" model="ir.ui.view">
            <field name="name">res.users.tree</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_tree"/>
            <field name="arch" type="xml">
                <xpath expr="field[@name='name']" position="after">
                    <field name="pipedrive_id" optional="show"/>
                </xpath>
            </field>
        </record>

        <record id="action_user_list_view_add_button" model="ir.actions.server">
                <field name="name">Sync To Pipedrive</field>
                <field name="type">ir.actions.server</field>
                <field name="model_id" ref="model_res_users"/>
                <field name="binding_model_id" ref="model_res_users"/>
                <field name="binding_view_types">list</field>
                <field name="state">code</field>
                <field name="code">
                    model.user_send_to_pipedrive()
                </field>
         </record>
    </data>
</odoo>