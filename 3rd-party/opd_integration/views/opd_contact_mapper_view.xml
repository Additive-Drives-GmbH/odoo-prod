<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_opd_contactmapper_tree" model="ir.ui.view">
        <field name="name">opd.contactmapper.tree</field>
        <field name="model">opd.contactmapper</field>
        <field name="arch" type="xml">
            <list>
                <field name="field_id" optional="show"/>
                <field name="internal_name" optional="show"/>
                <field name="label_name" optional="show"/>
                <field name="field_type" optional="show"/>
                <field name="pipedrive_instance_name" optional="show"/>
                <field name="system_name" optional="show"/>
                <field name="field_definition" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_opd_contactmapper_form" model="ir.ui.view">
        <field name="name">opd.contactmapper.form</field>
        <field name="model">opd.contactmapper</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="field_id"/>
                            <field name="pipedrive_instance_name"/>
                            <field name="system_name"/>
                        </group>
                        <group>
                            <field name="internal_name"/>
                            <field name="label_name"/>
                            <field name="field_type"/>
                            <field name="field_definition"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_opd_contactmapper" model="ir.actions.act_window">
        <field name="name">Contact Fields</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">opd.contactmapper</field>
        <field name="view_mode">list,form</field>
        <field name="context"></field>
    </record>

    <menuitem id="menu_fieldmapper_master"
              parent="menu_opd_root"
              name="Pipedrive Field Mapper"
              sequence="2"/>

    <menuitem id="menu_contactmapper"
              name="Contact Fields"
              action="action_opd_contactmapper"
              parent="menu_fieldmapper_master"
              sequence="2"/>

</odoo>
