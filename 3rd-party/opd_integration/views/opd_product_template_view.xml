<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_form_inherit" model="ir.ui.view">
            <field name="name">product.template.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                     <page string="Pipedrive Integration" name="Pipedrive Integration">
                         <group>
                             <field name="pipedrive_id"/>
                             <field name="sync_to_pipedrive"/>
                             <field name="odoo_hash"/>
                         </group>
                     </page>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                     <button name="product_send_to_pipedrive" class="oe_stat_button oe_highlight" icon="fa-refresh" string='SYNC TO PIPEDRIVE' type="object"/>
                </xpath>

            </field>
        </record>
        <record id="view_product_list_inherit" model="ir.ui.view">
            <field name="name">product.template.list</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="field[@name='activity_exception_decoration']" position="after">
                     <field name="pipedrive_id" optional="show"/>
                     <field name="sync_to_pipedrive" optional="show"/>
                </xpath>
            </field>
        </record>
         <record id="action_product_list_view_add_button" model="ir.actions.server">
                <field name="name">Sync To Pipedrive</field>
                <field name="type">ir.actions.server</field>
                <field name="model_id" ref="model_product_template"/>
                <field name="binding_model_id" ref="model_product_template"/>
                <field name="binding_view_types">list</field>
                <field name="state">code</field>
                <field name="code">
                    model.product_send_to_pipedrive()
                </field>
         </record>
    </data>
</odoo>