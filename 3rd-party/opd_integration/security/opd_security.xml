<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- Define a new module category -->
    <record model="res.groups.privilege" id="module_category_opd_integration">
        <field name="name">Odoo Pipedrive Integration</field>
        <field name="sequence">-100</field>
    </record>

    <!-- Define the new user group and link it to the new module category -->
    <record id="group_opd_integration_admin" model="res.groups">
        <field name="name">Odoo Plugin Admin</field>
        <field name="comment">The user will be able to Manage Integration.</field>
        <field name="privilege_id" ref="module_category_opd_integration"/>
    </record>

    <!-- Define an access rule for the user group -->
    <record id="opd_integration_admin_rule" model="ir.rule">
        <field name="name">Opd Integration Admin Rule</field>
        <field name="model_id" ref="opd_integration.model_opd_pipedriveinstance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_opd_integration_admin'))]"/>
    </record>
</odoo>