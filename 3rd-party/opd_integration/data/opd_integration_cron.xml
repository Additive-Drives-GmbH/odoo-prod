<odoo>
    <data>

        <record id="cron_fetch_odoo_pipedrive_all_modules_data" model="ir.cron">
            <field name="name">Fetch Odoo and Pipedrive All Modules Data</field>
            <field name="model_id" ref="model_opd_pipedriveinstance"/>
            <field name="state">code</field>
            <field name="code">model._cron_fetch_and_store_odoo_pipedrive_records_scheduler()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True" />
        </record>

         <record id="cron_fetch_odoo_pipedrive_activity" model="ir.cron">
            <field name="name">Fetch Pipedrive Activities</field>
            <field name="model_id" ref="model_opd_pipedriveinstance"/>
            <field name="state">code</field>
            <field name="code">model._cron_fetch_pipedrive_and_odoo_activity()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True" />
        </record>

        <!-- Define a new cron job -->
        <record id="cron_delete_old_log_records" model="ir.cron">
            <field name="name">Delete Logger Records</field>
            <field name="model_id" ref="model_opd_integration_pipedrivelogger"/>
            <field name="state">code</field>
            <field name="code">model._cron_delete_old_log_records()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True" />
        </record>

        <!-- Define a new cron job -->
        <record id="cron_delete_old_filters" model="ir.cron">
            <field name="name">Delete filter records</field>
            <field name="model_id" ref="model_opd_pipedriveinstance"/>
            <field name="state">code</field>
            <field name="code">model.scheduled_delete_all_instances()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>

